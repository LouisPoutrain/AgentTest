  "cards": [
    {
      "dot": "cyan",
      "title": "Execution Flow Moderne",
      "items": [
        "User envoie message via Frontend (Next.js 14+)",
        "FastAPI 0.111+ route vers Crew Runner (JWT Auth)",
        "Celery publie tâche dans Redis (asynchrone)",
        "Worker consomme tâche et exécute CrewAI",
        "LiteLLM gère les appels LLM (sécurisé)",
        "Résultat stocké dans PostgreSQL (ACID)",
        "Réponse retournée via SSE ou polling"
      ]
    },
    {
      "dot": "emerald",
      "title": "Sécurité & Isolation",
      "items": [
        "JWT/OAuth2 pour l'authentification",
        "Validation stricte des entrées (Pydantic)",
        "Liste blanche des modèles LLM autorisés",
        "Wrapper sécurisé pour LiteLLM",
        "PostgreSQL pour la persistance des utilisateurs",
        "CORS configuré via ALLOWED_ORIGINS",
        "Logs structurés avec rotation"
      ]
    },
    {
      "dot": "rose",
      "title": "Observabilité Complète",
      "items": [
        "OpenTelemetry pour le tracing distribué",
        "Prometheus pour les métriques (latence, erreurs, coûts)",
        "Grafana pour les dashboards",
        "Alertes sur seuils de coûts LLM",
        "Logs structurés avec niveaux (DEBUG, INFO, WARNING, ERROR)",
        "Suivi des tokens par utilisateur",
        "Détection proactive des problèmes"
      ]
    },
    {
      "dot": "amber",
      "title": "Architecture Hybride",
      "items": [
        "PostgreSQL pour les données relationnelles (Users, Sessions)",
        "PGVector pour la mémoire sémantique (RAG)",
        "ChromaDB conservé pour la compatibilité",
        "Transactions ACID pour la cohérence",
        "Requêtes SQL complexes possibles",
        "Sauvegarde fiable et scalable"
      ]
    }
  ]
