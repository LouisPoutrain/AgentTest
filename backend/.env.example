# ── LLM Provider (requis) ──────────────────────────────────────────────
# Clé API de votre provider LLM compatible LiteLLM
# Exemples : OpenAI, Mistral, Gemini, Ollama, Groq, Together AI...
LLM_API_KEY=sk-your-key-here

# URL de base de l'API LLM
# Exemples :
#   OpenAI:    https://api.openai.com/v1
#   Mistral:   https://api.mistral.ai/v1
#   Ollama:    http://localhost:11434/v1
#   Groq:      https://api.groq.com/openai/v1
LLM_BASE_URL=https://api.openai.com/v1

# ── Google Gemini (optionnel) ──────────────────────────────────────────
# Utilisé pour certains outils spécifiques (ex: modèles Gemini directs)
# GEMINI_API_KEY=your-gemini-key

# ── Workspace ──────────────────────────────────────────────────────────
# Dossier racine autorisé pour les opérations de lecture/écriture des agents.
# Par défaut : racine du dépôt. Définissez un chemin absolu pour autoriser
# les agents à travailler sur d'autres dossiers.
# PROJECT_ROOT=/chemin/vers/votre/dossier

# ── CORS ───────────────────────────────────────────────────────────────
# Origines autorisées pour les requêtes cross-origin (séparées par des virgules)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Base de données ────────────────────────────────────────────────────
# Chemin du fichier SQLite pour l'historique des conversations
# SESSIONS_DB=sessions.db
